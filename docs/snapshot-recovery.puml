@startuml snapshot-create
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName monospaced
skinparam ArrowColor #444444
skinparam ActivityBorderColor #666666

title Joxette — Create & Export Snapshot

|REST Client|
start
:POST /cassettes/snapshots { "name": "my-snapshot" }\nOR POST /cassettes/snapshots/export { "name": "my-snapshot" };

|CassetteLifecycleService|
:validateSnapshotName ([a-zA-Z0-9_-]+);
:Files.createDirectories(snapshotsBase/name);
:synchronized(duckDB)\n  EXPORT DATABASE 'snapshotsBase/name'\n  -> all tables as Parquet + schema.sql;
:directorySize(snapshotDir);
:INSERT INTO snapshots (name, created_at, size_bytes)\nON CONFLICT DO UPDATE;

if (export to object store?) then (yes)
  :Files.walk(snapshotDir) -> collect file list;
  repeat
    :S3Client.putObject(\n  bucket, prefix/name/relPath, file\n);
  repeat while (more files?)
  :deleteDirectory(snapshotDir)\n[local copy removed — S3 is source of truth];
  :return ObjectStoreSnapshotInfo { name, createdAt, sizeBytes, s3Uri };
else (local only)
  :return SnapshotInfo { name, createdAt, sizeBytes };
endif
stop

@enduml


@startuml snapshot-restore
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName monospaced
skinparam ArrowColor #444444
skinparam ActivityBorderColor #666666

title Joxette — Restore Snapshot

|REST Client|
start
:POST /cassettes/snapshots/{name}/restore;

|CassetteLifecycleService|
note right
  Stop all active topic recorders
  before restoring to avoid
  concurrent writes!
end note
:validateSnapshotName(name);
:check snapshotsBase/name exists;
:synchronized(duckDB)\n  IMPORT DATABASE 'snapshotsBase/name'\n  -> replaces all existing tables;
stop

@enduml


@startuml snapshot-rebuild-known-entities
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName monospaced
skinparam ArrowColor #444444
skinparam ActivityBorderColor #666666

title Joxette — Rebuild known_entities (Disaster Recovery)

|REST Client|
start
:POST /cassettes/entities/rebuild-known-entities\n?recoverOrphanedFiles=false (default);
note right
  recoverOrphanedFiles is opt-in (default false).
  An operator sets it to true only as a deliberate
  action after confirming catalog loss — see
  resolveEntityDataSource() javadoc for the full
  ambiguity/residual-risk contract.
end note

|CassetteLifecycleService|
:listEntityTypes() from config;
:synchronized(duckDB) {;
:CALL ducklake_flush_inlined_data('lake');
:CHECKPOINT;
:DELETE FROM known_entities;

repeat
  :check table lake.main.entity_{type} exists\n(duckdb_tables());
  if (table missing?) then (yes)
    :skip this entity type;
  else (no)
    :resolveEntityDataSource(catalogSrc, tableName,\n  entityType, recoverOrphanedFiles);

    if (catalog table has > 0 live rows?) then (yes)
      :dataSource = lake.main.entity_{type}\n(catalog is deletion-aware; trust it,\nincluding when the count is 0);
    else (0 live rows)
      if (ducklake_list_files('lake', tableName)\nstill lists tracked files?) then (yes — e.g. GDPR erase/truncate)
        :dataSource = null;
        note right
          Zero rows but the catalog still tracks
          this table's file history: trust the
          deletion, never scan raw storage.
        end note
      else (no tracked files)
        if (recoverOrphanedFiles == true\nAND object-storage-path configured?) then (yes)
          :build PER-TABLE-scoped glob:\nobjectStoragePath/main/{tableName}/**/*.parquet;
          note right
            Scoped to this table's own default
            DuckLake on-disk path — never a
            bucket-wide glob, so recovery for one
            entity type can never pick up another
            entity type's (or general cassettes')
            files.
          end note
          :parquetSrc = read_parquet(glob,\n  union_by_name=true, hive_partitioning=false);
          if (parquetSrc has matching rows?) then (yes)
            :INSERT INTO lake.main.entity_{type}\n  SELECT 13 fixed columns FROM parquetSrc\n  WHERE entity_id IS NOT NULL;
            note right
              Re-populates the empty DuckLake catalog
              table from its own orphaned Parquet
              files on object storage so downstream
              queries (replay, stats, compaction)
              work normally.
            end note
            :dataSource = lake.main.entity_{type}\n(freshly re-populated);
          else (no)
            :dataSource = null;
          endif
        else (not requested / not configured)
          :dataSource = null;
        endif
      endif
    endif

    if (dataSource != null?) then (yes)
      :INSERT INTO known_entities\n  SELECT entity_type, entity_id,\n         MIN(recorded_at), MAX(recorded_at)\n  FROM dataSource GROUP BY entity_id\n  ON CONFLICT DO UPDATE;
      :count rows upserted for this type;
    else (no)
      :0 rows for this type;
    endif
  endif
repeat while (more entity types?)

:} end synchronized(duckDB);
:return total rows upserted;
stop

@enduml
